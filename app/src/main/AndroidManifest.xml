<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- self-update from GitHub Releases through a PackageInstaller session -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".TiViBroApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network"
        android:supportsRtl="false"
        android:theme="@style/Theme.TiViBro">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- the home screen's preview channel and Watch Next: tivibro://home, /live/…, /archive/… (see tvhome.DeepLink).
                 Not BROWSABLE: web pages can't send these, only apps such as the launcher -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tivibro" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
        <!-- card pictures for the home screen: read-only, generated images only -->
        <provider
            android:name=".tvhome.CardProvider"
            android:authorities="${applicationId}.cards"
            android:exported="true" />
    </application>
</manifest>
